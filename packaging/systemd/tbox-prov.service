[Unit]
Description=TBOX Provisioning Service
Documentation=https://app.notion.com/TBOX-PROV-SPEC
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/tbox-prov
Restart=on-failure
RestartSec=5
UMask=0077

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/tbox /var/log/tbox /tmp

# Resource limits
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
